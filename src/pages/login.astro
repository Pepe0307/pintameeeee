---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../lib/supabase-ssr';

const supabase = createSupabaseServerClient(Astro.cookies);

// If already logged in, redirect to admin
const { data: { session } } = await supabase.auth.getSession();
if (session) {
  return Astro.redirect('/admin');
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email')?.toString();
  const password = formData.get('password')?.toString();

  if (email && password) {
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      errorMessage = error.message;
    } else {
      return Astro.redirect('/admin');
    }
  } else {
    errorMessage = 'Email and password are required.';
  }
}
---

<BaseLayout title="Admin Login" description="Acceso seguro al panel de administración de Pintame">
  <main class="min-h-screen flex items-center justify-center p-4 relative overflow-hidden bg-zinc-950">
    <!-- Decoración de fondo -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500/20 rounded-full blur-[100px]"></div>
    </div>

    <div class="glass-panel w-full max-w-md p-8 rounded-3xl relative z-10 border border-white/10 animate-fade-in-up">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-fraunces text-white mb-2">Pintame Admin</h1>
        <p class="text-zinc-400">Inicia sesión para gestionar tu galería</p>
      </div>

      {errorMessage && (
        <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm">
          {errorMessage}
        </div>
      )}

      <form method="POST" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-medium text-zinc-300 mb-2">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            class="w-full bg-black/30 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all"
            placeholder="artista@pintame.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-zinc-300 mb-2">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required 
            class="w-full bg-black/30 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all"
            placeholder="••••••••"
          />
        </div>

        <button 
          type="submit"
          class="w-full bg-white text-black font-medium py-3 rounded-xl hover:bg-zinc-200 transition-colors shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_30px_rgba(255,255,255,0.4)]"
        >
          Entrar al Panel
        </button>
      </form>
      
      <div class="mt-6 text-center">
        <a href="/" class="text-zinc-500 hover:text-white text-sm transition-colors">Volver a la galería</a>
      </div>
    </div>
  </main>
</BaseLayout>
