---
/**
 * AddToCartButton.astro
 * 
 * Button to add a product to the localStorage cart.
 * Shows "Agregar al carrito" normally, and a brief "¡Agregado!" confirmation on click.
 */

interface Props {
  productId: string;
  productTitle: string;
  productPrice: number;
  currency: string;
  imageUrl: string;
  category: string | null;
}

const { productId, productTitle, productPrice, currency, imageUrl, category } = Astro.props;
---

<button
  class="btn-primary px-8 py-4 text-lg inline-flex items-center justify-center gap-2 w-full cursor-pointer transition-colors"
  data-add-to-cart
  data-product-id={productId}
  data-product-title={productTitle}
  data-product-price={productPrice.toString()}
  data-product-currency={currency}
  data-product-image={imageUrl}
  data-product-category={category || ''}
>
  <!-- Shopping bag icon -->
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
    <path d="M6 2a1 1 0 0 1 .993 .883l.007 .117v1.068l13.071 .935a1 1 0 0 1 .929 1.024l-.01 .114l-1 7a1 1 0 0 1 -.877 .853l-.113 .006h-12v2h10a3 3 0 1 1 -2.995 3.176l-.005 -.176l.005 -.176c.017 -.288 .074 -.564 .166 -.824h-5.342a3 3 0 1 1 -5.824 1.176l-.005 -.176l.005 -.176a3.002 3.002 0 0 1 1.995 -2.654v-12.17h-1a1 1 0 0 1 -.993 -.883l-.007 -.117a1 1 0 0 1 .883 -.993l.117 -.007h2zm0 16a1 1 0 1 0 0 2a1 1 0 0 0 0 -2m11 0a1 1 0 1 0 0 2a1 1 0 0 0 0 -2" />
  </svg>
  <span class="btn-text">Agregar al carrito</span>
</button>

<script>
  import { addToCart } from '../utils/cart';

  function setupAddToCartButtons() {
    document.querySelectorAll('[data-add-to-cart]').forEach(btn => {
      // Avoid double-binding
      if ((btn as HTMLElement).dataset.bound) return;
      (btn as HTMLElement).dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const item = {
          id: el.dataset.productId!,
          title: el.dataset.productTitle!,
          price: parseFloat(el.dataset.productPrice!),
          currency: el.dataset.productCurrency!,
          imageUrl: el.dataset.productImage!,
          category: el.dataset.productCategory || null,
        };

        addToCart(item);

        // Visual feedback
        const textSpan = el.querySelector('.btn-text');
        if (textSpan) {
          const original = textSpan.textContent;
          textSpan.textContent = '¡Agregado! ✓';
          el.classList.add('!bg-green-500');
          setTimeout(() => {
            textSpan.textContent = original;
            el.classList.remove('!bg-green-500');
          }, 1500);
        }
      });
    });
  }

  setupAddToCartButtons();
  document.addEventListener('astro:after-swap', setupAddToCartButtons);
</script>
