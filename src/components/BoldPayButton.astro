---
/**
 * BoldPayButton.astro
 *
 * Renders the Bold payment button for online checkout.
 * Computes the integrity-signature (SHA256) server-side using the secret key.
 * Uses Bold's official combined approach: src + data attributes on the same script tag.
 *
 * Keys are read at runtime via src/lib/bold.ts (astro:env), so the secret is
 * never inlined into the build output or sent to the browser.
 *
 * Hash format: SHA256("{orderId}{amount}{currency}{secretKey}")
 * Example: SHA256("inv033439400COPkgfq2nN0o52XqnuXZWIN2F")
 *
 * Docs: https://developers.bold.co/pagos-en-linea/boton-de-pagos/integracion-manual
 */

import { getBoldConfig, computeIntegritySignature } from '../lib/bold';

interface Props {
  /** Product title shown in checkout */
  productTitle: string;
  /** Amount in COP (pesos), e.g. 50000 for $50,000 COP */
  productPrice: number;
  /** ISO currency code, defaults to COP */
  currency?: string;
  /** Product identifier (used as base for unique order ID) */
  productId: string;
}

const {
  productTitle,
  productPrice,
  currency = 'COP',
  productId,
} = Astro.props;

const bold = getBoldConfig();

// Amount for Bold is in pesos (integer, no decimals for COP)
const amount = Math.round(productPrice);

// Generate a unique order ID per page render (product + timestamp)
const orderId = `${productId.slice(0, 8)}-${Date.now()}`;

const integritySignature = bold
  ? await computeIntegritySignature(orderId, amount, currency, bold.secretKey)
  : '';
---

{bold ? (
  <div class="bold-pay-container">
    <script
      is:inline
      src="https://checkout.bold.co/library/boldPaymentButton.js"
      data-bold-button
      data-api-key={bold.apiKey}
      data-amount={amount.toString()}
      data-currency={currency}
      data-description={productTitle}
      data-order-id={orderId}
      data-integrity-signature={integritySignature}
    ></script>
  </div>
) : (
  <p class="text-sm text-amber-600 bg-amber-50 px-4 py-2 rounded-lg">
    ⚠️ Falta configurar <code>PUBLIC_BOLD_API_KEY</code> / <code>BOLD_SECRET_KEY</code> en las variables de entorno.
  </p>
)}
