---
/**
 * BoldPayButton.astro
 *
 * Bold payment button for a single product.
 *
 * The button is loaded in the browser: it asks /api/bold-signature for a signed
 * order (priced on the server from Supabase and saved as 'pending'), then
 * injects Bold's script. Signing in the browser instead of at render time
 * means crawlers and plain page views don't create orders.
 *
 * If payments aren't configured or the product can't be paid online, the
 * container stays empty and WhatsApp remains as the way to buy.
 *
 * Docs: https://developers.bold.co/pagos-en-linea/boton-de-pagos/integracion-manual
 */

interface Props {
  /** Product UUID */
  productId: string;
}

const { productId } = Astro.props;
---

<div class="bold-pay-container" data-bold-product={productId}></div>

<script>
  import { mountBoldButton } from '../utils/bold-client';

  function setupBoldButtons() {
    document.querySelectorAll<HTMLElement>('[data-bold-product]').forEach(el => {
      // Avoid double-mounting
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';
      mountBoldButton(el, [{ id: el.dataset.boldProduct!, quantity: 1 }]);
    });
  }

  setupBoldButtons();
  document.addEventListener('astro:after-swap', setupBoldButtons);
</script>
